{
  "manifest_version": 3,
  "name": "Clip_Forge",
  "version": "1.0",
  "description": "An extension to convert long youtube videos into short viral clips",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}